{
  "name": "@qbsheet/director",
  "version": "0.1.0",
  "private": true,
  "description": "QBSheet Director desktop tournament control application",
  "type": "module",
  "scripts": {
    "dev": "vite --host 127.0.0.1 --port 1420",
    "build": "tsc --noEmit && vite build",
    "typecheck": "tsc --noEmit",
    "preview": "vite preview --host 127.0.0.1",
    "test": "vitest run",
    "tauri": "tauri",
    "tauri:dev": "tauri dev",
    "tauri:build": "tauri build",
    "tauri:check": "tauri info"
  },
  "dependencies": {
    "@fontsource/ibm-plex-sans": "^5.2.5",
    "@tauri-apps/api": "^2.11.1",
    "react": "^18.3.1",
    "react-dom": "^18.3.1"
  },
  "devDependencies": {
    "@tauri-apps/cli": "^2.11.4",
    "@types/node": "^22.20.1",
    "@types/react": "^18.3.18",
    "@types/react-dom": "^18.3.5",
    "@vitejs/plugin-react": "^6.1.0",
    "jsdom": "^25.0.1",
    "typescript": "^5.7.2",
    "vite": "^8.0.0",
    "vitest": "^4.1.11"
  },
  "engines": {
    "node": ">=20"
  }
}
