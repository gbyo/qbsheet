{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "YF Shuttle",
  "version": "0.1.0",
  "identifier": "com.qbsheet.shuttle",
  "build": {
    "beforeDevCommand": "npm run dev",
    "devUrl": "http://127.0.0.1:1426",
    "beforeBuildCommand": "npm run build",
    "frontendDist": "../dist"
  },
  "app": {
    "withGlobalTauri": false,
    "security": {
      "capabilities": ["shuttle-main"],
      "csp": "default-src 'self'; connect-src 'self' ipc: http://ipc.localhost; img-src 'self' data: blob:; style-src 'self' 'unsafe-inline'; font-src 'self' data:;"
    },
    "windows": [
      {
        "label": "main",
        "title": "YF Shuttle",
        "width": 960,
        "height": 720,
        "minWidth": 760,
        "minHeight": 560,
        "resizable": true,
        "dragDropEnabled": false,
        "visible": true,
        "center": true
      }
    ]
  },
  "bundle": {
    "active": true,
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "targets": "all",
    "createUpdaterArtifacts": false
  }
}
