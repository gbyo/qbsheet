{
  "name": "@qbsheet/qblive-backend-cloudflare",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "QBLive reference backend: a Cloudflare Worker and SQLite Durable Object deployed into the tournament director's own account",
  "scripts": {
    "sync-protocol": "node scripts/sync-protocol.mjs",
    "check-protocol": "node scripts/sync-protocol.mjs --check",
    "dev": "wrangler dev",
    "deploy": "wrangler deploy",
    "test": "vitest --run",
    "typecheck": "tsc --noEmit"
  },
  "devDependencies": {
    "@cloudflare/vitest-pool-workers": "^0.22.0",
    "@cloudflare/workers-types": "^5.20260831.1",
    "typescript": "^5.7.2",
    "vitest": "^4.1.11",
    "wrangler": "^4.0.0"
  },
  "allowScripts": {
    "esbuild@0.28.1": true,
    "workerd@1.20260815.1": true,
    "workerd@1.20260831.1": true
  }
}
