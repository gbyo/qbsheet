{
  "protocol": "QBTCP",
  "version": 1,
  "capabilities": ["pairing", "assignment", "progress", "result", "recovery", "help", "presence", "stream"],
  "qbj_version": "2.1.1",
  "name": "Greenwood Fall Invitational",
