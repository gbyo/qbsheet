{
  "name": "@qbsheet/qblive-projection",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "Deterministic public projection from the canonical QBSheet tournament document to QBLive",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    },
    "./fixture": {
      "types": "./dist/fixture.d.ts",
      "import": "./dist/fixture.js"
    }
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "test": "vitest --run tests",
    "typecheck": "tsc -p tsconfig.json --noEmit"
  },
  "dependencies": {
    "@qbsheet/qblive-protocol": "0.1.0",
    "@qbsheet/tournament-domain": "0.1.0"
  }
}
