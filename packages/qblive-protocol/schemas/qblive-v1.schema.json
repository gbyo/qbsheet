{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://qbsheet.com/schemas/qblive-v1.schema.json",
  "title": "QBLive v1",
  "description": "The QBSheet Live public protocol. Normative for third-party servers and clients. A server that satisfies this schema and the semantics in docs/QBLIVE.md is a QBLive server, whoever operates it.",
  "$defs": {
    "id": { "type": "string", "minLength": 1, "maxLength": 4096 },
    "timestamp": {
      "type": "string",
      "description": "ISO 8601 with an explicit offset or Z. A bare local time is invalid: a spectator in another zone would read it wrong.",
      "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}T[0-9]{2}:[0-9]{2}:[0-9]{2}(\\.[0-9]{1,9})?(Z|[+-][0-9]{2}:[0-9]{2})$"
    },
    "nullableTimestamp": { "oneOf": [{ "$ref": "#/$defs/timestamp" }, { "type": "null" }] },
    "nullableString": { "type": ["string", "null"], "maxLength": 4096 },
    "capabilities": {
      "type": "object",
      "required": ["snapshot"],
      "properties": {
        "snapshot": { "const": true },
        "events": { "type": "boolean" },
        "stream": { "type": "boolean" },
        "applePush": { "type": "boolean" },
        "minimumReplayRevision": { "type": "integer", "minimum": 0 }
      },
      "additionalProperties": false
    },
    "tournament": {
      "type": "object",
      "required": ["id", "name", "date", "venue", "organizer", "timeZone", "status"],
      "properties": {
        "id": { "$ref": "#/$defs/id" },
        "name": { "type": "string", "maxLength": 4096 },
        "date": { "$ref": "#/$defs/nullableString" },
        "venue": { "$ref": "#/$defs/nullableString" },
        "organizer": { "$ref": "#/$defs/nullableString" },
        "timeZone": { "type": "string", "maxLength": 64 },
        "status": { "enum": ["upcoming", "in-progress", "complete"] }
      },
      "additionalProperties": false
    },
    "player": {
      "type": "object",
      "required": ["id", "name", "teamId"],
      "properties": {
        "id": { "$ref": "#/$defs/id" },
        "name": { "type": "string", "maxLength": 4096 },
        "teamId": { "$ref": "#/$defs/id" }
      },
      "additionalProperties": false
    },
    "team": {
      "type": "object",
      "required": ["id", "name", "organization", "seed"],
      "properties": {
        "id": { "$ref": "#/$defs/id" },
        "name": { "type": "string", "maxLength": 4096 },
        "organization": { "$ref": "#/$defs/nullableString" },
        "seed": { "type": ["number", "null"] },
        "players": {
          "description": "Present only when the tournament publishes player names.",
          "type": "array",
          "maxItems": 32,
          "items": { "$ref": "#/$defs/player" }
        }
      },
      "additionalProperties": false
    },
    "room": {
      "type": "object",
      "required": ["id", "name", "building", "directions"],
      "properties": {
        "id": { "$ref": "#/$defs/id" },
        "name": { "type": "string", "maxLength": 4096 },
        "building": { "$ref": "#/$defs/nullableString" },
        "directions": { "$ref": "#/$defs/nullableString" }
      },
      "additionalProperties": false
    },
    "timelineEvent": {
      "type": "object",
      "required": ["id", "type", "title", "description", "scheduledStart", "scheduledEnd", "sequence", "teamIds", "roomId", "location"],
      "properties": {
        "id": { "$ref": "#/$defs/id" },
        "type": { "enum": ["round", "lunch", "break", "check-in", "awards", "ceremony", "custom"] },
        "title": { "type": "string", "maxLength": 4096 },
        "description": { "$ref": "#/$defs/nullableString" },
        "scheduledStart": { "$ref": "#/$defs/nullableTimestamp" },
        "scheduledEnd": { "$ref": "#/$defs/nullableTimestamp" },
        "sequence": {
          "description": "Explicit position in the tournament-day sequence, or null when the publisher predates day ordering. Consumers sort by it first and fall back to scheduled time.",
          "type": ["number", "null"]
        },
        "teamIds": { "type": "array", "items": { "$ref": "#/$defs/id" }, "maxItems": 512 },
        "roomId": { "oneOf": [{ "$ref": "#/$defs/id" }, { "type": "null" }] },
        "location": { "$ref": "#/$defs/nullableString" }
      },
      "additionalProperties": false
    },
    "scheduledGame": {
      "type": "object",
      "required": ["id", "roundId", "roundName", "roundNumber", "sequence", "phaseId", "phaseName", "poolId", "poolName", "teamIds", "roomId", "scheduledStart", "state"],
      "properties": {
        "id": { "$ref": "#/$defs/id" },
        "roundId": { "$ref": "#/$defs/id" },
        "roundName": { "type": "string", "maxLength": 4096 },
        "roundNumber": { "type": ["number", "null"] },
        "sequence": {
          "description": "Explicit day-sequence position of this game's round, or null when the publisher predates day ordering. Consumers sort by it first.",
          "type": ["number", "null"]
        },
        "phaseId": { "oneOf": [{ "$ref": "#/$defs/id" }, { "type": "null" }] },
        "phaseName": { "$ref": "#/$defs/nullableString" },
        "poolId": { "oneOf": [{ "$ref": "#/$defs/id" }, { "type": "null" }] },
        "poolName": { "$ref": "#/$defs/nullableString" },
        "teamIds": { "type": "array", "items": { "$ref": "#/$defs/id" }, "maxItems": 2 },
        "roomId": { "oneOf": [{ "$ref": "#/$defs/id" }, { "type": "null" }] },
        "scheduledStart": {
          "description": "An actual scheduled time or null. A QBLive server never publishes an estimated or projected start.",
          "$ref": "#/$defs/nullableTimestamp"
        },
        "state": { "enum": ["upcoming", "live", "final", "bye", "cancelled"] }
      },
      "additionalProperties": false
    },
    "teamScore": {
      "type": "object",
      "required": ["teamId", "score"],
      "properties": { "teamId": { "$ref": "#/$defs/id" }, "score": { "type": "number" } },
      "additionalProperties": false
    },
    "result": {
      "type": "object",
      "required": ["gameId", "roundId", "scores", "outcome", "acceptedAt"],
      "properties": {
        "gameId": { "$ref": "#/$defs/id" },
        "roundId": { "$ref": "#/$defs/id" },
        "scores": { "type": "array", "maxItems": 2, "items": { "$ref": "#/$defs/teamScore" } },
        "outcome": { "enum": ["played", "forfeit", "cancelled"] },
        "acceptedAt": { "$ref": "#/$defs/nullableTimestamp" }
      },
      "additionalProperties": false
    },
    "liveGame": {
      "type": "object",
      "required": ["gameId", "roundId", "teamIds", "roomId"],
      "properties": {
        "gameId": { "$ref": "#/$defs/id" },
        "roundId": { "$ref": "#/$defs/id" },
        "teamIds": { "type": "array", "items": { "$ref": "#/$defs/id" }, "maxItems": 2 },
        "roomId": { "oneOf": [{ "$ref": "#/$defs/id" }, { "type": "null" }] },
        "scores": {
          "description": "Present only when the tournament publishes live scores.",
          "type": "array",
          "maxItems": 2,
          "items": { "$ref": "#/$defs/teamScore" }
        },
        "tossupsRead": {
          "description": "Present only when the tournament publishes live progress.",
          "type": "integer",
          "minimum": 0
        }
      },
      "additionalProperties": false
    },
    "column": {
      "type": "object",
      "required": ["id", "label", "kind"],
      "properties": {
        "id": { "type": "string", "maxLength": 128 },
        "label": { "type": "string", "maxLength": 128 },
        "kind": {
          "description": "text, integer, decimal, percentage, record, rank, score, team, player, or a future kind. A client that meets an unknown kind renders the cell's display string.",
          "type": "string",
          "maxLength": 64
        },
        "alignment": { "enum": ["leading", "center", "trailing"] },
        "precision": { "type": "integer", "minimum": 0, "maximum": 9 },
        "description": { "type": "string", "maxLength": 512 }
      },
      "additionalProperties": false
    },
    "cell": {
      "type": "object",
      "required": ["value"],
      "properties": {
        "value": { "type": ["string", "number", "null"] },
        "display": { "type": "string", "maxLength": 4096 },
        "entityId": { "$ref": "#/$defs/id" }
      },
      "additionalProperties": false
    },
    "row": {
      "type": "object",
      "required": ["id", "cells"],
      "properties": {
        "id": { "type": "string", "maxLength": 4096 },
        "cells": { "type": "array", "maxItems": 48, "items": { "$ref": "#/$defs/cell" } },
        "teamId": { "$ref": "#/$defs/id" },
        "playerId": { "$ref": "#/$defs/id" }
      },
      "additionalProperties": false
    },
    "dataTable": {
      "type": "object",
      "required": ["id", "title", "scope", "columns", "rows"],
      "properties": {
        "id": { "type": "string", "maxLength": 256 },
        "title": { "type": "string", "maxLength": 256 },
        "scope": { "type": "string", "maxLength": 256 },
        "scopeLabel": { "type": "string", "maxLength": 256 },
        "columns": { "type": "array", "maxItems": 48, "items": { "$ref": "#/$defs/column" } },
        "rows": { "type": "array", "maxItems": 2048, "items": { "$ref": "#/$defs/row" } }
      },
      "additionalProperties": false
    },
    "announcement": {
      "type": "object",
      "required": ["id", "title", "body", "severity", "publishedAt", "updatedAt", "expiresAt", "audienceTeamIds"],
      "properties": {
        "id": { "$ref": "#/$defs/id" },
        "title": { "type": "string", "maxLength": 256 },
        "body": {
          "description": "Plain text. Never HTML or Markdown: the server that supplies it is not the client's own.",
          "type": "string",
          "maxLength": 4096
        },
        "severity": { "enum": ["information", "important", "urgent"] },
        "publishedAt": { "$ref": "#/$defs/timestamp" },
        "updatedAt": { "$ref": "#/$defs/nullableTimestamp" },
        "expiresAt": { "$ref": "#/$defs/nullableTimestamp" },
        "audienceTeamIds": { "type": "array", "items": { "$ref": "#/$defs/id" }, "maxItems": 512 }
      },
      "additionalProperties": false
    },
    "sections": {
      "type": "object",
      "properties": {
        "tournament": { "$ref": "#/$defs/tournament" },
        "teams": { "type": "array", "maxItems": 512, "items": { "$ref": "#/$defs/team" } },
        "rooms": { "type": "array", "maxItems": 256, "items": { "$ref": "#/$defs/room" } },
        "timeline": { "type": "array", "maxItems": 512, "items": { "$ref": "#/$defs/timelineEvent" } },
        "schedule": { "type": "array", "maxItems": 8192, "items": { "$ref": "#/$defs/scheduledGame" } },
        "results": { "type": "array", "maxItems": 8192, "items": { "$ref": "#/$defs/result" } },
        "liveGames": { "type": "array", "maxItems": 256, "items": { "$ref": "#/$defs/liveGame" } },
        "standings": { "type": "array", "maxItems": 64, "items": { "$ref": "#/$defs/dataTable" } },
        "statistics": { "type": "array", "maxItems": 64, "items": { "$ref": "#/$defs/dataTable" } },
        "announcements": { "type": "array", "maxItems": 256, "items": { "$ref": "#/$defs/announcement" } }
      },
      "additionalProperties": false
    },
    "snapshot": {
      "type": "object",
      "required": [
        "protocolVersion", "publicationId", "revision", "generatedAt", "capabilities", "final",
        "tournament", "teams", "rooms", "timeline", "schedule", "results", "liveGames",
        "standings", "statistics", "announcements"
      ],
      "properties": {
        "protocolVersion": { "const": 1 },
        "publicationId": { "$ref": "#/$defs/id" },
        "revision": { "type": "integer", "minimum": 0 },
        "generatedAt": { "$ref": "#/$defs/timestamp" },
        "capabilities": { "$ref": "#/$defs/capabilities" },
        "final": { "type": "boolean" },
        "tournament": { "$ref": "#/$defs/tournament" },
        "teams": { "type": "array", "maxItems": 512, "items": { "$ref": "#/$defs/team" } },
        "rooms": { "type": "array", "maxItems": 256, "items": { "$ref": "#/$defs/room" } },
        "timeline": { "type": "array", "maxItems": 512, "items": { "$ref": "#/$defs/timelineEvent" } },
        "schedule": { "type": "array", "maxItems": 8192, "items": { "$ref": "#/$defs/scheduledGame" } },
        "results": { "type": "array", "maxItems": 8192, "items": { "$ref": "#/$defs/result" } },
        "liveGames": { "type": "array", "maxItems": 256, "items": { "$ref": "#/$defs/liveGame" } },
        "standings": { "type": "array", "maxItems": 64, "items": { "$ref": "#/$defs/dataTable" } },
        "statistics": { "type": "array", "maxItems": 64, "items": { "$ref": "#/$defs/dataTable" } },
        "announcements": { "type": "array", "maxItems": 256, "items": { "$ref": "#/$defs/announcement" } }
      },
      "additionalProperties": false
    },
    "manifest": {
      "type": "object",
      "required": ["protocolVersion", "publicationId", "revision", "generatedAt", "tournament", "capabilities", "endpoints", "final"],
      "properties": {
        "protocolVersion": { "const": 1 },
        "publicationId": { "$ref": "#/$defs/id" },
        "revision": { "type": "integer", "minimum": 0 },
        "generatedAt": { "$ref": "#/$defs/timestamp" },
        "tournament": { "$ref": "#/$defs/tournament" },
        "capabilities": { "$ref": "#/$defs/capabilities" },
        "endpoints": {
          "type": "object",
          "required": ["snapshot"],
          "properties": {
            "snapshot": { "type": "string" },
            "events": { "type": "string" },
            "stream": { "type": "string" }
          },
          "additionalProperties": false
        },
        "final": { "type": "boolean" }
      },
      "additionalProperties": false
    },
    "event": {
      "type": "object",
      "required": ["revision", "generatedAt", "sections"],
      "properties": {
        "revision": { "type": "integer", "minimum": 0 },
        "generatedAt": { "$ref": "#/$defs/timestamp" },
        "sections": { "$ref": "#/$defs/sections" },
        "final": { "type": "boolean" }
      },
      "additionalProperties": false
    },
    "eventPage": {
      "type": "object",
      "required": ["protocolVersion", "publicationId", "currentRevision", "events", "resyncRequired"],
      "properties": {
        "protocolVersion": { "const": 1 },
        "publicationId": { "$ref": "#/$defs/id" },
        "currentRevision": { "type": "integer", "minimum": 0 },
        "events": { "type": "array", "maxItems": 256, "items": { "$ref": "#/$defs/event" } },
        "resyncRequired": { "type": "boolean" }
      },
      "additionalProperties": false
    },
    "error": {
      "type": "object",
      "required": ["error", "message"],
      "properties": {
        "error": {
          "enum": ["not-found", "unauthorized", "forbidden", "conflict", "bad-request", "payload-too-large", "unsupported-protocol", "gone", "rate-limited", "internal"]
        },
        "message": { "type": "string", "maxLength": 4096 },
        "currentRevision": { "type": "integer", "minimum": 0 }
      },
      "additionalProperties": false
    }
  }
}
