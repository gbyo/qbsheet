<?xml version="1.0" encoding="UTF-8"?>
<!--
  The QBSheet Live App Clip.

  `NSAppClip` carries the App Clip's own configuration. `NSAppClipRequestEphemeralUserNotification`
  is what lets the Clip ask for the eight-hour ephemeral notification window without a permission
  prompt, which is how a spectator who scanned a code gets a room-change announcement.
-->
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
  <key>CFBundleDevelopmentRegion</key>
  <string>$(DEVELOPMENT_LANGUAGE)</string>
  <key>CFBundleExecutable</key>
  <string>$(EXECUTABLE_NAME)</string>
  <key>CFBundleIdentifier</key>
  <string>$(PRODUCT_BUNDLE_IDENTIFIER)</string>
  <key>CFBundleInfoDictionaryVersion</key>
  <string>6.0</string>
  <key>CFBundleName</key>
  <string>$(PRODUCT_NAME)</string>
  <key>CFBundlePackageType</key>
  <string>$(PRODUCT_BUNDLE_PACKAGE_TYPE)</string>
  <key>CFBundleDisplayName</key>
  <string>QBSheet Live</string>
  <key>CFBundleShortVersionString</key>
  <string>$(MARKETING_VERSION)</string>
  <key>CFBundleVersion</key>
  <string>$(CURRENT_PROJECT_VERSION)</string>
  <key>LSRequiresIPhoneOS</key>
  <true/>
  <key>UISupportedInterfaceOrientations</key>
  <array>
    <string>UIInterfaceOrientationPortrait</string>
    <string>UIInterfaceOrientationLandscapeLeft</string>
    <string>UIInterfaceOrientationLandscapeRight</string>
  </array>
  <!--
    A Debug-only URL scheme. A universal link needs live.qbsheet.com to serve the AASA file and the
    app to be signed with the matching Team ID; neither holds in a simulator or on CI, and without
    this the app could not be exercised end to end before the domain exists. Stripped from Release
    by the `#if DEBUG` in Shared/AppEntry.swift, which is the only code that reads it.
  -->
  <key>CFBundleURLTypes</key>
  <array>
    <dict>
      <key>CFBundleURLName</key>
      <string>com.qbsheet.live.debug</string>
      <key>CFBundleURLSchemes</key>
      <array>
        <string>qbsheetlive</string>
      </array>
    </dict>
  </array>
  <key>NSUserActivityTypes</key>
  <array>
    <string>NSUserActivityTypeBrowsingWeb</string>
  </array>
  <key>NSSupportsLiveActivities</key>
  <true/>
  <key>NSAppClip</key>
  <dict>
    <key>NSAppClipRequestEphemeralUserNotification</key>
    <true/>
    <!--
      False: QBSheet Live needs no location, and an App Clip that asks for one is an App Clip a
      spectator declines. Room directions are text the Director wrote.
    -->
    <key>NSAppClipRequestLocationConfirmation</key>
    <false/>
  </dict>
  <key>ITSAppUsesNonExemptEncryption</key>
  <false/>
</dict>
</plist>
