<?xml version="1.0" encoding="UTF-8"?>
<!--
  The QBSheet Live App Clip.

  `NSAppClip` carries the App Clip's own configuration. `NSAppClipRequestEphemeralUserNotification`
  is what lets the Clip ask for the eight-hour ephemeral notification window without a permission
  prompt, which is how a spectator who scanned a code gets a room-change announcement.
-->
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
  <key>CFBundleDevelopmentRegion</key>
  <string>$(DEVELOPMENT_LANGUAGE)</string>
  <key>CFBundleExecutable</key>
  <string>$(EXECUTABLE_NAME)</string>
  <key>CFBundleIdentifier</key>
  <string>$(PRODUCT_BUNDLE_IDENTIFIER)</string>
  <key>CFBundleInfoDictionaryVersion</key>
  <string>6.0</string>
  <key>CFBundleName</key>
  <string>$(PRODUCT_NAME)</string>
  <key>CFBundlePackageType</key>
  <string>$(PRODUCT_BUNDLE_PACKAGE_TYPE)</string>
  <key>CFBundleDisplayName</key>
  <string>QBSheet Live</string>
  <key>CFBundleShortVersionString</key>
  <string>$(MARKETING_VERSION)</string>
  <key>CFBundleVersion</key>
  <string>$(CURRENT_PROJECT_VERSION)</string>
  <key>LSRequiresIPhoneOS</key>
  <true/>
  <key>UISupportedInterfaceOrientations</key>
  <array>
    <string>UIInterfaceOrientationPortrait</string>
    <string>UIInterfaceOrientationLandscapeLeft</string>
    <string>UIInterfaceOrientationLandscapeRight</string>
  </array>
  <!--
    iPad is in TARGETED_DEVICE_FAMILY, and an iPad app that does not declare all four orientations
    is treated as one that cannot multitask. Upside-down is deliberately absent on iPhone, where no
    system app supports it, and present here, where the home indicator has no fixed edge.
  -->
  <key>UISupportedInterfaceOrientations~ipad</key>
  <array>
    <string>UIInterfaceOrientationPortrait</string>
    <string>UIInterfaceOrientationPortraitUpsideDown</string>
    <string>UIInterfaceOrientationLandscapeLeft</string>
    <string>UIInterfaceOrientationLandscapeRight</string>
  </array>
  <!--
    An empty UILaunchScreen is what tells iOS the app is built for the full screen rather than
    letterboxed at a legacy size. It has to be a literal key in this file: the
    INFOPLIST_KEY_UILaunchScreen_Generation build setting only applies to an Info.plist that Xcode
    generates, and these targets supply their own, so the setting was silently doing nothing.
    The dictionary is empty on purpose — the launch state is a plain background, and every pixel of
    the first frame is SwiftUI's.
  -->
  <key>UILaunchScreen</key>
  <dict/>
  <!--
    A Debug-only URL scheme. A universal link needs live.qbsheet.com to serve the AASA file and the
    app to be signed with the matching Team ID; neither holds in a simulator or on CI, and without
    this the app could not be exercised end to end before the domain exists. Stripped from Release
    by the `#if DEBUG` in Shared/AppEntry.swift, which is the only code that reads it.
  -->
  <key>CFBundleURLTypes</key>
  <array>
    <dict>
      <key>CFBundleURLName</key>
      <string>com.qbsheet.live.debug</string>
      <key>CFBundleURLSchemes</key>
      <array>
        <string>qbsheetlive</string>
      </array>
    </dict>
  </array>
  <key>NSUserActivityTypes</key>
  <array>
    <string>NSUserActivityTypeBrowsingWeb</string>
  </array>
  <key>NSSupportsLiveActivities</key>
  <true/>
  <key>NSAppClip</key>
  <dict>
    <key>NSAppClipRequestEphemeralUserNotification</key>
    <true/>
    <!--
      False: QBSheet Live needs no location, and an App Clip that asks for one is an App Clip a
      spectator declines. Room directions are text the Director wrote.
    -->
    <key>NSAppClipRequestLocationConfirmation</key>
    <false/>
  </dict>
  <key>ITSAppUsesNonExemptEncryption</key>
  <false/>
</dict>
</plist>
