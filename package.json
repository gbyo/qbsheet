{
  "name": "qbsheet",
  "private": true,
  "version": "0.1.0",
  "description": "QBSheet, an offline-first electronic quiz bowl scoresheet that runs entirely in the browser",
  "workspaces": [
    "apps/director",
    "packages/*"
  ],
  "repository": {
    "type": "git",
    "url": "https://github.com/gbyo/qbsheet.git"
  },
  "main": "./dist/core/index.js",
  "types": "./dist/core/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/core/index.d.ts",
      "import": "./dist/core/index.js",
      "require": "./dist/core/index.js"
    }
  },
  "files": [
    "dist"
  ],
  "license": "AGPL-3.0-or-later",
  "type": "module",
  "scripts": {
    "start": "vite",
    "dev": "vite",
    "build": "tsc -p tsconfig.build.json && vite build",
    "build:core": "tsc -p tsconfig.core.json && node scripts/write-core-package.mjs",
    "preview": "vite preview",
    "lint": "eslint .",
    "format": "prettier --write \"**/*.{ts,tsx,js,mjs,css}\"",
    "format:check": "prettier --check \"**/*.{ts,tsx,js,mjs,css}\"",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "vitest",
    "test:state-space": "vitest --run tests/RoomGameStateSpace.test.ts",
    "test:stress": "QBSHEET_DEEP_STRESS=1 vitest --run tests/RoomGameStateSpace.test.ts",
    "test:property": "vitest --run tests/RoomGameProperty.test.ts",
    "test:browser": "playwright test",
    "director:dev": "npm run dev --workspace=@qbsheet/director",
    "director:build": "npm run build --workspace=@qbsheet/director",
    "director:test": "npm run test --workspace=@qbsheet/director",
    "director:tauri:dev": "npm run tauri:dev --workspace=@qbsheet/director",
    "director:tauri:build": "npm run tauri:build --workspace=@qbsheet/director",
    "director:core:test": "npm run test --workspace=@qbsheet/tournament-core",
    "director:formats:test": "npm run test --workspace=@qbsheet/tournament-formats",
    "test:browser:yellowfruit": "playwright test e2e/YellowFruitInterop.spec.ts",
    "test:mutation": "stryker run",
    "test:mutation:dry": "stryker run --dryRunOnly",
    "prepare": "npm run build:core && npm run build --workspace=@qbsheet/tournament-core && npm run build --workspace=@qbsheet/tournament-formats"
  },
  "dependencies": {
    "@qbsheet/tournament-core": "0.1.0",
    "@qbsheet/tournament-formats": "0.1.0",
    "@fontsource/ibm-plex-sans": "^5.2.5",
    "fflate": "^0.8.3",
    "jsqr": "^1.4.0",
    "react": "^18.3.1",
    "react-dom": "^18.3.1"
  },
  "devDependencies": {
    "@eslint/js": "^9.17.0",
    "@playwright/test": "^1.62.1",
    "@stryker-mutator/core": "^9.6.1",
    "@stryker-mutator/vitest-runner": "^9.6.1",
    "@testing-library/jest-dom": "^7.0.0",
    "@testing-library/react": "^16.1.0",
    "@testing-library/user-event": "^14.6.5",
    "@types/jsdom": "^21.1.7",
    "@types/node": "^22.20.1",
    "@types/react": "^18.3.18",
    "@types/react-dom": "^18.3.5",
    "@vitejs/plugin-react": "^6.1.0",
    "eslint": "^9.17.0",
    "eslint-config-prettier": "^10.1.8",
    "eslint-plugin-jsx-a11y": "^6.10.2",
    "eslint-plugin-react": "^7.37.3",
    "eslint-plugin-react-hooks": "^7.1.1",
    "fake-indexeddb": "^6.2.5",
    "fast-check": "^4.9.0",
    "globals": "^17.9.0",
    "jsdom": "^25.0.1",
    "marked": "^18.0.10",
    "prettier": "^3.9.6",
    "typescript": "^5.7.2",
    "typescript-eslint": "^8.67.0",
    "vite": "^8.0.0",
    "vitest": "^4.1.11"
  },
  "engines": {
    "node": ">=20"
  },
  "allowScripts": {
    "esbuild@0.25.12": true,
    "esbuild@0.21.5": true
  }
}
