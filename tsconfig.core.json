{
  "extends": "./tsconfig.json",
  "compilerOptions": {
    "module": "CommonJS",
    "moduleResolution": "Node",
    "outDir": "dist",
    "rootDir": "src",
    "declaration": true,
    "declarationMap": false,
    "sourceMap": true,
    "noEmit": false,
    "tsBuildInfoFile": "dist/.core.tsbuildinfo"
  },
  "include": ["src/core/index.ts"]
}
